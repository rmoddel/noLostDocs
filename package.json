{
  "name": "nolostdocs",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "postcss": "8.5.28"
  },
  "workspaces": [
    "apps",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @nolostdocs/web",
    "dev:web-next": "npm run dev -w @nolostdocs/web",
    "build:web": "npm run build -w @nolostdocs/web",
    "build:web-next": "npm run build -w @nolostdocs/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:security-scan": "node --experimental-strip-types --test tests/security-and-scan.mjs"
  }
}
